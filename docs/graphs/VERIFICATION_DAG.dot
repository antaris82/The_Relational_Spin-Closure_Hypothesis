digraph VERIFICATION_DAG {
  rankdir=LR;
  node [shape=box, fontsize=10];
  "CLAIM-L001" [label="CLAIM-L001\nThe primitive input is a positive Euclidean three-space."];
  "CLAIM-L002" [label="CLAIM-L002\nThe carrier R (+) R^3 carries an intrinsic Lorentz quadratic form of signature (1,3)."];
  "CLAIM-L003" [label="CLAIM-L003\nCl3 is the Clifford algebra of the positive Euclidean three-form, with generators squaring to +1."];
  "CLAIM-L004" [label="CLAIM-L004\nThe paravector embedding realises the intrinsic quadratic form inside Cl3."];
  "CLAIM-L005" [label="CLAIM-L005\nClifford and Jordan structures are compatible on the embedded spin factor."];
  "CLAIM-L006" [label="CLAIM-L006\nThe embedded carrier generates Cl3."];
  "CLAIM-L007" [label="CLAIM-L007\nThe intrinsic Spin group double covers the intrinsic Lorentz group."];
  "CLAIM-L008" [label="CLAIM-L008\nThe double cover is topologically qualified."];
  "CLAIM-L009" [label="CLAIM-L009\nspinCover admits continuous local sections everywhere."];
  "CLAIM-L010" [label="CLAIM-L010\nThe tested deformation is generated by a native one-parameter Spin subgroup with an explicit projected action."];
  "CLAIM-G001" [label="CLAIM-G001\nThe base gluing datum is additional information, not derivable from the local core."];
  "CLAIM-G002" [label="CLAIM-G002\nThe emergent base is a charted space over the four-dimensional local model."];
  "CLAIM-G003" [label="CLAIM-G003\nA smooth base gluing produces a C-infinity four-manifold."];
  "CLAIM-G004" [label="CLAIM-G004\nThe emergent smooth four-manifold certificate."];
  "CLAIM-G005" [label="CLAIM-G005\nThe tangent transitions of the emergent manifold are the derivatives of the gluing maps."];
  "CLAIM-G006" [label="CLAIM-G006\nThe solder is an additional coupling datum."];
  "CLAIM-G007" [label="CLAIM-G007\nA weak (merely fibrewise) solder is insufficient."];
  "CLAIM-G008" [label="CLAIM-G008\nA regular solder is exactly a regular bundle equivalence between the internal Lorentz bundle and TM."];
  "CLAIM-G009" [label="CLAIM-G009\nA regular solder induces a smooth tangent Lorentz metric of signature (1,3)."];
  "CLAIM-G010" [label="CLAIM-G010\nThe transported tangent form is chart independent."];
  "CLAIM-G011" [label="CLAIM-G011\nA regular solder forces orientation compatibility of the emergent atlas."];
  "CLAIM-G012" [label="CLAIM-G012\nA nontrivial orientation obstruction rules out every regular solder."];
  "CLAIM-G013" [label="CLAIM-G013\nA regular solder forces the project-native Spin obstruction to vanish."];
  "CLAIM-G014" [label="CLAIM-G014\nA nontrivial project-native Spin obstruction rules out the solder."];
  "CLAIM-G015" [label="CLAIM-G015\nA regular solder yields a coherent future-cone reduction."];
  "CLAIM-G016" [label="CLAIM-G016\nThe residual solder freedom is exactly a free transitive regular gauge action."];
  "CLAIM-G017" [label="CLAIM-G017\nThe regular solder is a gate: it does not always exist."];
  "CLAIM-G018" [label="CLAIM-G018\nThe discrete fixed-cover Spin-lift freedom survives the bottom-up construction."];
  "CLAIM-G019" [label="CLAIM-G019\nThe fixed-cover lift multiplicity grows with the number of loops."];
  "CLAIM-G020" [label="CLAIM-G020\nThe two gates reject the two adversarial controls independently."];
  "CLAIM-G021" [label="CLAIM-G021\nThe Task-36 adversarial battery is bundled in one certificate."];
  "CLAIM-G022" [label="CLAIM-G022\nThe frozen periodic control base is a genuine smooth four-manifold with a two-component overlap."];
  "CLAIM-S001" [label="CLAIM-S001\nThe tested native transition deformation is globally admissible for every finite parameter value on the frozen control."];
  "CLAIM-S002" [label="CLAIM-S002\nThe admissibility locus of the tested family is the whole real line."];
  "CLAIM-S003" [label="CLAIM-S003\nAdmissibility is symmetric under sign reversal of the parameter."];
  "CLAIM-S004" [label="CLAIM-S004\nAll tested parameter values lie in one full-Spin Cech gauge orbit."];
  "CLAIM-S005" [label="CLAIM-S005\nThe projected Lorentz cocycles are gauge related as well."];
  "CLAIM-S006" [label="CLAIM-S006\nAt the narrower kernel-valued equivalence the parameter values are distinguished."];
  "CLAIM-S007" [label="CLAIM-S007\nThere is an explicit certified regular solder branch for every finite parameter value."];
  "CLAIM-S008" [label="CLAIM-S008\nAlong the explicit branch the induced tangent Lorentz metric is exactly parameter independent."];
  "CLAIM-S009" [label="CLAIM-S009\nThe projected Lorentz gauge of the smoke test is smooth; the Spin-side gauge is only continuous."];
  "CLAIM-S010" [label="CLAIM-S010\nThe regular solder solution spaces at two parameter values correspond, with equal induced tangent metrics."];
  "CLAIM-S011" [label="CLAIM-S011\nScientific reading of the smoke test."];
  "CLAIM-N001" [label="CLAIM-N001\nWeak-solder insufficiency control."];
  "CLAIM-N002" [label="CLAIM-N002\nDiscontinuous induced metric control."];
  "CLAIM-N003" [label="CLAIM-N003\nOrientation-reversing no-solder control."];
  "CLAIM-N004" [label="CLAIM-N004\nIndependent Spin obstruction control."];
  "CLAIM-N005" [label="CLAIM-N005\nFixed-cover discrete lift-freedom control."];
  "CLAIM-N006" [label="CLAIM-N006\nTask-37 anti-vacuity controls for the closure predicate."];
  "CLAIM-N007" [label="CLAIM-N007\nTask-38 pure-gauge smoke-test control record."];
  "CLAIM-N008" [label="CLAIM-N008\nCombinatorial label control."];
  "CLAIM-N009" [label="CLAIM-N009\nSpin-type data do not imply a tangent Lorentz coupling."];
  "CLAIM-N010" [label="CLAIM-N010\nPositive control: the gates are not vacuously closed."];
  "CLAIM-B001" [label="CLAIM-B001\nThere is no smooth Lie-group package for the intrinsic Spin group."];
  "CLAIM-B002" [label="CLAIM-B002\nThe project-native Spin obstruction is not formally compared with w2(TM)."];
  "CLAIM-B003" [label="CLAIM-B003\nNo connection, parallel transport, holonomy or curvature exists in the project."];
  "CLAIM-B004" [label="CLAIM-B004\nThe periodic control model is not proved to be S^1 x R^3."];
  "CLAIM-B005" [label="CLAIM-B005\nFixed-cover lift freedom is not global H^1(M; Z/2)."];
  "CLAIM-B006" [label="CLAIM-B006\nThe time-orientation reduction is not proved equivalent to general time-orientability."];
  "CLAIM-B007" [label="CLAIM-B007\nThere is no general existence theorem for the regular solder."];
  "CLAIM-B008" [label="CLAIM-B008\nNo gravitational dynamics has been derived."];
  "CLAIM-B009" [label="CLAIM-B009\nWhere the next genuinely nontrivial deformation might live is an open question."];
  "CLAIM-G023" [label="CLAIM-G023\nOne Lean certificate aggregates the frozen intermediate state."];
  "CLAIM-S012" [label="CLAIM-S012\nThe deformation experiment has a theorem-level interface record."];
  "CLAIM-L011" [label="CLAIM-L011\nThe project already contains an intrinsic six-dimensional Lorentz-skew Lie-algebra layer."];
  "CLAIM-B010" [label="CLAIM-B010\nThe existing Lorentz-skew Lie algebra is not identified with an infinitesimal structure of the intrinsic Spin group."];
